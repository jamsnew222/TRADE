# Finnhub API key for real market data (free tier at https://finnhub.io/)
# Without this, the simulator shows clearly-labeled SIMULATED prices.
# Copy this file to .env.local and paste your key.
NEXT_PUBLIC_FINNHUB_API_KEY=your_api_key_here

# RevenueCat public SDK keys (safe to embed - they only identify the app)
# Get these from app.revenuecat.com after creating your project
NEXT_PUBLIC_RC_ANDROID_API_KEY=
NEXT_PUBLIC_RC_IOS_API_KEY=
